# MariaDB
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=change_me

# Nextcloud admin (chỉ áp dụng lần đầu khởi tạo)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me

# Trusted domains (cách nhau bằng dấu cách)
NEXTCLOUD_TRUSTED_DOMAINS=localhost nextcloud.yourdomain.com

# Reverse proxy / Cloudflare Tunnel
OVERWRITE_PROTOCOL=https
OVERWRITE_HOST=nextcloud.yourdomain.com
OVERWRITE_CLI_URL=https://nextcloud.yourdomain.com
TRUSTED_PROXIES=172.16.0.0/12

# Ports
NEXTCLOUD_PORT=9090

# Đường dẫn lưu data
DB_DATA_PATH=E:/_DATA/nextcloud/db
NEXTCLOUD_DATA_PATH=E:/_DATA/nextcloud/nextcloud
