LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=change_me
LABEL_STUDIO_DOMAIN=label.yourdomain.com

# IP LAN của máy chạy Docker (truy cập http://<IP>:<port>)
HOST_IP=192.168.1.100
LABELSTUDIO_PORT=8080
# URL gốc cho link tuyệt đối, để trống để dùng được cả localhost / IP / domain
LABEL_STUDIO_HOST=

LABELSTUDIO_DATA_PATH=E:/_DATA/labelstudio
