# Sinh bằng: openssl rand -hex 64
SECRET_KEY_BASE=change_me
OPENPROJECT_HOST_NAME=pm.yourdomain.com
# IP LAN của máy chạy Docker (localhost / 127.0.0.1 luôn được cho phép)
HOST_IP=192.168.1.100
# false để truy cập được qua http://localhost / http://IP; domain vẫn HTTPS nhờ Cloudflare
OPENPROJECT_HTTPS=true
OPENPROJECT_PORT=8888

# Đường dẫn lưu data (Windows ví dụ: E:/_DATA/openproject/pgdata)
PGDATA_PATH=./data/pgdata
ASSETS_PATH=./data/assets
