# Database
DB_USERNAME=dify
DB_PASSWORD=change_me
DB_DATABASE=dify

# Redis
REDIS_PASSWORD=change_me

# Weaviate vector database
WEAVIATE_API_KEY=change_me

# Sandbox
SANDBOX_API_KEY=change_me

# Dify secret key (sinh bằng: openssl rand -hex 32)
SECRET_KEY=change_me

# URLs (thay bằng domain thực khi dùng Cloudflare Tunnel)
CONSOLE_WEB_URL=https://dify.yourdomain.com
CONSOLE_API_URL=https://dify.yourdomain.com
SERVICE_API_URL=https://dify.yourdomain.com
APP_WEB_URL=https://dify.yourdomain.com

# Port expose ra host (Cloudflare Tunnel trỏ vào port này)
DIFY_PORT=2203

# Storage
STORAGE_TYPE=local

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Đường dẫn lưu data
DB_DATA_PATH=/mnt/data2/dify/db
REDIS_DATA_PATH=/mnt/data2/dify/redis
WEAVIATE_DATA_PATH=/mnt/data2/dify/weaviate
API_STORAGE_PATH=/mnt/data2/dify/storage
