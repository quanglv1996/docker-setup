# MinIO credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me

# URLs (dùng khi chạy sau reverse proxy / Cloudflare Tunnel)
MINIO_CONSOLE_URL=https://minio.yourdomain.com

# Ports expose ra host
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Đường dẫn lưu data (Windows ví dụ: E:/_DATA/minio)
MINIO_DATA_PATH=./data
